# Django Secret Key
SECRET_KEY=django-insecure-change-this-in-production

# Debug Mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Email Configuration (Choose Method A or B)
# ==========================================

# METHOD A: Gmail SMTP with App Password (Easiest)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-digit App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in below:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_app_password

# METHOD B: Gmail OAuth2 API
# Place credentials.json in backend/ and run:
# python scripts/setup_gmail_oauth.py
# (This creates gmail-token.json automatically)
