# ==============================================================================
# Fit-Flow QMS — Production Environment Variables (.env)
# ==============================================================================

# Core Django Settings
DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=quality_check.settings.production
DJANGO_SECRET_KEY=generate_a_secure_50_character_random_string_here
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100,your-server-domain.local

# Ports
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL Database Configuration
POSTGRES_DB=fitflow_db
POSTGRES_USER=fitflow_admin
POSTGRES_PASSWORD=choose_a_strong_postgres_password_here

# Frontend CORS & CSRF (Comma-separated URLs of Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.100:3000

# Security (Set to 1 if behind an SSL/HTTPS reverse proxy like Nginx or Caddy)
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Email Configuration (Optional SMTP / Gmail API)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com
